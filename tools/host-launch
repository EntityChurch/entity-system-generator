#!/bin/sh
# tools/host-launch — boot a composed peer and point the oracle at it. TARGET-NEUTRAL.
#
#   ./tools/host-launch <target> <composition> [validate-peer args...]
#
# ## Why this is in tools/ and not copied per target
#
# It was copied per target -- three files, ~70 code lines each, and a diff of the three
# showed that the ONLY genuine differences were: which binary to exec, which environment
# it needs, and where the two arms' entry points live. Everything else -- the port, the
# keypair, the spawn-and-redirect, the reap trap, the readiness wait, the COMPOSED check,
# the oracle invocation, the stderr surfacing -- was the same protocol transcribed three
# times. It had already drifted twice: a readiness budget of 100 on the port written first
# and 150 on the two written after (AP-10), and two spellings of the same error message.
#
# **N copies of one protocol is the shape keystone paid for**: 46 copies of `run-s4.sh`,
# one defect reproduced in 36 of them. `languages/<target>/` exists so the (extension x
# target) cell never holds a driver; it does not follow that the target should hold the
# whole harness. The rule the tree now runs on:
#
#   the SHARED PROTOCOL lives in tools/ -- one copy, and a fix reaches every target
#   the ECOSYSTEM POLISH lives in languages/<target>/host-entry -- and stays small
#
# A per-target file that grows past "which binary, which environment" is a signal that
# something protocol-shaped has been written in the wrong place.
#
# ## The contract with a target
#
# `languages/<target>/host-entry` is SOURCED by this script and must define one function:
#
#   resolve_entry()   sets ENTRY_ARGV to the argv that starts the host, for the current
#                     $ARM ("bare" or "composed"). May export environment. May refuse.
#
# with $ROOT $TARGET $TARGET_DIR $COMP $STAGE $ARM $PLAN in scope, and `plan_field`
# available. It runs INSIDE the target's toolchain image.
#
# Runs with --network=none: the oracle is a fedora ELF binary that runs in each image too,
# so it and the peer share one loopback.
#
# Defaults to `-category content`. Pass args to override -- e.g. `-profile core` for the
# regression guard, which is not optional: our second failure mode is one keystone never
# has, the peer was right and we broke it.

set -eu

TARGET="${1:?usage: host-launch <target> <composition> [validate-peer args...]}"
COMP="${2:?usage: host-launch <target> <composition> [validate-peer args...]}"
shift 2

ROOT="${GENERATOR_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
TARGET_DIR="$ROOT/languages/$TARGET"
STAGE="$TARGET_DIR/output/$COMP/build"
PLAN="$TARGET_DIR/output/$COMP/PLAN.json"
PORT="${PORT:-7777}"
ORACLE="${ORACLE:-$ROOT/../entity-core-keystone/output/s4-oracles/validate-peer}"
# The B-ROLE REFERENCE PEER. `--profile core` alone leaves the whole `origination` category
# collapsed into a single `origination/skipped` sentinel; with `-reference-peer <addr>` its
# three checks actually run. A SKIP COUNTS AS A FAILURE ([ADR-0012]), so a category we have
# never once executed is not a gap in the oracle — it is a flag we never passed.
#
# Found 2026-09-09 by diffing our executed set against keystone's: ours 776, theirs 778, at
# the SAME oracle commit. The +2 is 3 real checks minus the 1 sentinel they replace. This is
# `entity-core-go`'s own `entity-peer`, from the same pinned build as the oracle, on a second
# loopback port. Loopback is private to the container (--network=none), so PORT+2 cannot
# collide with any other run on this box.
REFPEER="${REFPEER:-$ROOT/../entity-core-keystone/output/s4-oracles/entity-peer}"
RPORT="${RPORT:-$((PORT + 2))}"
REFPEER_FLAG=""

[ -d "$TARGET_DIR" ] || { echo "host-launch: no target at languages/$TARGET" >&2; exit 2; }
[ -f "$PLAN" ] || { echo "host-launch: no resolved plan at $PLAN" >&2
  echo "  run: ./tools/compose.py languages/$TARGET/compositions/$COMP" >&2; exit 2; }

# ONE plan reader, not one per target. It was three -- node for `typescript`, python3 for
# the other two -- which is a JSON parser transcribed three times to read four scalars.
# python3 is present in every toolchain image (checked, all three); a target whose image
# lacks it is a real finding and should surface here rather than be worked around.
command -v python3 >/dev/null || {
  echo "host-launch: this target's image has no python3, which the shared harness needs" >&2
  echo "  to read the resolved plan. That is a toolchain-image finding, not a reason to" >&2
  echo "  re-transcribe the parser into languages/$TARGET/." >&2; exit 2; }

plan_field() { python3 -c '
import json, sys
plan = json.load(open(sys.argv[1]))
value = plan
for key in sys.argv[2].split("."):
    value = value.get(key) if isinstance(value, dict) else None
sys.stdout.write("\n".join(value) if isinstance(value, list) else str(value or ""))
' "$PLAN" "$1"; }

PLAN_TARGET="$(plan_field target)"
[ "$PLAN_TARGET" = "$TARGET" ] || {
  echo "host-launch: plan target is '$PLAN_TARGET', not '$TARGET'" >&2; exit 2; }

# BARE=1 launches the PEER'S OWN host instead of the composed one. That is the baseline
# arm, and it is not optional: "pre-existing failure" is a claim, and a claim about a
# failure needs the run that establishes it. [ADR-0012] forbids labelling a failure
# pre-existing without bisecting; this is the cheapest honest bisect there is -- same
# oracle, same flags, same container, one variable.
if [ "${BARE:-0}" = "1" ]; then ARM="bare"; else ARM="composed"; fi

# ---- the target's own polish -------------------------------------------------
ENTRY_SPEC="$TARGET_DIR/host-entry"
[ -f "$ENTRY_SPEC" ] || { echo "host-launch: $ENTRY_SPEC does not exist" >&2
  echo "  Every target declares how its host is started; there is no default." >&2; exit 2; }
ENTRY_ARGV=""
. "$ENTRY_SPEC"
command -v resolve_entry >/dev/null 2>&1 || {
  echo "host-launch: $ENTRY_SPEC defines no resolve_entry()" >&2; exit 2; }
resolve_entry
[ -n "$ENTRY_ARGV" ] || {
  echo "host-launch: $ENTRY_SPEC's resolve_entry() set no ENTRY_ARGV for arm=$ARM" >&2
  echo "  A silent empty argv would exec the shell and hang at the readiness wait." >&2
  exit 2; }

# The oracle is a gitignored local build from the sibling entity-core-go tree. Missing it
# must be LOUD: keystone's harness ended in `|| true` and swallowed a missing binary for
# weeks, exiting 0 having validated nothing.
[ -x "$ORACLE" ] || { echo "host-launch: ERROR oracle not found or not executable at $ORACLE" >&2
  echo "  It is built from the sibling entity-core-go repo. It is the oracle BECAUSE" >&2
  echo "  it is not the thing under test; we do not ship a copy." >&2; exit 3; }

# The peer's persistent identity at the standard on-disk location, so the validator's
# probes that co-sign AS the peer can find its keypair. Seed 0x11 x 32 matches the host
# default, so peer_id is unchanged.
NAME="${PEERNAME:-conformance}"
KPDIR="${HOME:-/root}/.entity/peers/$NAME"
mkdir -p "$KPDIR"
printf '%s\n%s\n%s\n' \
  '-----BEGIN ENTITY PRIVATE KEY-----' \
  'ERERERERERERERERERERERERERERERERERERERERERE=' \
  '-----END ENTITY PRIVATE KEY-----' > "$KPDIR/keypair"

HOST_OUT="$(mktemp)"; HOST_ERR="$(mktemp)"
# shellcheck disable=SC2086
$ENTRY_ARGV --port "$PORT" --name "$NAME" --debug-open-grants --validate \
  >"$HOST_OUT" 2>"$HOST_ERR" &
HOST_PID=$!

# Deterministic teardown. `kill` only DELIVERS the signal; a fire-and-forget trap returns
# while the peer still owns the listening socket, and a second run in the same container
# fails to bind. keystone measured windows over 400 ms on some runtimes.
reap_host() {
  [ -n "${HOST_PID:-}" ] || return 0
  kill -0 "$HOST_PID" 2>/dev/null || return 0
  kill -TERM "$HOST_PID" 2>/dev/null || true
  j=0
  while [ "$j" -lt 50 ]; do
    kill -0 "$HOST_PID" 2>/dev/null || return 0
    j=$((j + 1)); sleep 0.1
  done
  kill -KILL "$HOST_PID" 2>/dev/null || true
  wait "$HOST_PID" 2>/dev/null || true
}
# The reference peer's reaper, defined HERE rather than beside `refpeer_up` further down,
# because the trap below names it: `sh` resolves a trap body at signal time, so a script that
# exits between this line and that definition would fire a trap calling a function that does
# not exist yet. Same shape as reaping before surfacing — the ordering is the point.
refpeer_reap() {
  [ -n "${REF_PID:-}" ] || return 0
  kill -0 "$REF_PID" 2>/dev/null || return 0
  kill -TERM "$REF_PID" 2>/dev/null || true
  k=0
  while [ "$k" -lt 50 ]; do
    kill -0 "$REF_PID" 2>/dev/null || return 0
    k=$((k + 1)); sleep 0.1
  done
  kill -KILL "$REF_PID" 2>/dev/null || true
  wait "$REF_PID" 2>/dev/null || true
}

trap 'refpeer_reap; reap_host' EXIT INT TERM

# The readiness budget is a PROFILE FIELD, not a literal (D17 / AP-10). It was a literal
# in each copy and had drifted 100/150/150 with no comment on any of the three.
STARTUP_TICKS="$(plan_field profile.startup_ticks)"
: "${STARTUP_TICKS:?host-launch: profile declares no [gate].startup_ticks}"

i=0
while [ "$i" -lt "$STARTUP_TICKS" ]; do
  grep -q '^LISTENING' "$HOST_OUT" 2>/dev/null && break
  if ! kill -0 "$HOST_PID" 2>/dev/null; then
    echo "host-launch: host exited before LISTENING:" >&2; cat "$HOST_ERR" >&2; exit 1
  fi
  i=$((i + 1)); sleep 0.1
done
head -1 "$HOST_OUT"

# The COMPOSED line proves the extension installed. A composed peer that silently
# installed nothing is byte-identical to a bare peer from the outside, and every content
# check would fail with a message about the PEER.
if [ "$ARM" = "composed" ]; then
  grep '^COMPOSED' "$HOST_ERR" || {
    echo "host-launch: the host printed no COMPOSED line -- nothing installed" >&2; exit 1; }
else
  echo "BASELINE arm=bare (no extensions installed)"
fi

mkdir -p "$TARGET_DIR/output/$COMP/reports"

# ---- the B-role reference peer, for the ORACLE path only ---------------------
#
# NOT started for a `CLIENT` run. The reference is an ORACLE INPUT — `validate-peer` dials it
# to drive `origination/{reference_connect,reference_ready,dispatch_outbound_reentry}` — and
# nothing under `gates/ext-checks` knows it exists. Starting it for every client would leave a
# process and a port that no consumer reads, which is the kind of thing that later gets
# mistaken for a dependency.
refpeer_up() {
  # A MISSING REFERENCE IS FATAL, NOT SILENT. Without this the three checks quietly become a
  # skip again — the exact coverage loss this exists to end — and it would present as a
  # slightly smaller total that nothing re-derives. D14's asymmetry: a wrong cohort number
  # usually UNDERSTATES a capability, and nothing re-checks in that direction.
  [ -x "$REFPEER" ] || {
    echo "host-launch: ERROR reference peer not found or not executable at $REFPEER" >&2
    echo "  It is entity-core-go's own entity-peer, built beside the oracle at the pinned" >&2
    echo "  digest. Without it the whole 'origination' category SKIPS, and a skip is a" >&2
    echo "  failure -- so this refuses rather than measuring two checks fewer in silence." >&2
    exit 3; }
  "$REFPEER" -addr "127.0.0.1:$RPORT" -open-access >"$REF_OUT" 2>"$REF_ERR" &
  REF_PID=$!
  # Readiness goes to STDERR, and it is POLLED rather than slept on: a fixed sleep is either
  # too slow on every run or too short on a loaded host, and a reference that is not up yet
  # fails `reference_connect` in a way that reads as a defect in the peer under test.
  # Reuses the target's declared STARTUP_TICKS rather than a second literal (D17 / AP-10).
  r=0
  while [ "$r" -lt "$STARTUP_TICKS" ]; do
    if grep -q "Ready to accept connections" "$REF_ERR" 2>/dev/null; then
      REFPEER_FLAG="-reference-peer 127.0.0.1:$RPORT"
      return 0
    fi
    if ! kill -0 "$REF_PID" 2>/dev/null; then
      echo "host-launch: ERROR reference peer exited before ready" >&2
      cat "$REF_ERR" >&2; exit 1
    fi
    r=$((r + 1)); sleep 0.1
  done
  echo "host-launch: ERROR reference peer never became ready on :$RPORT" >&2
  cat "$REF_ERR" >&2
  exit 1
}

# WHO DRIVES THE BOOTED HOST. Default: the oracle, which is why this script exists.
#
# `CLIENT` points it at something else -- today `languages/<t>/gates/ext-checks/exec`, the
# authored extension checks. The boot protocol is the SAME protocol either way (port,
# keypair, spawn, readiness wait, COMPOSED assertion, reap-before-surfacing), and the one
# thing this repo has already paid for twice is N copies of one protocol: `host-launch`
# exists because three targets each held a transcription of it and two had drifted.
# A second driver copying the boot sequence to run a different client would be that
# mistake in a new direction.
#
# The client is exec'd with $ADDR in the environment and receives "$@" verbatim, so it
# never has to know how the host got there. `|| true` matches the oracle's treatment: a
# non-zero client is a RESULT to be read from its output, not a launcher failure -- the
# launcher's own failures are the exits above, which are loud.
if [ -n "${CLIENT:-}" ]; then
  [ -x "$CLIENT" ] || { echo "host-launch: CLIENT is not executable: $CLIENT" >&2; exit 2; }
  ADDR="127.0.0.1:$PORT" ARM="$ARM" TARGET="$TARGET" COMP="$COMP" "$CLIENT" "$@" || true
else
  [ "$#" -eq 0 ] && set -- -category content
  REF_OUT="$(mktemp)"; REF_ERR="$(mktemp)"
  refpeer_up
  # $REFPEER_FLAG goes BEFORE "$@" so an explicit caller value still wins — Go's flag package
  # takes the last occurrence. Unquoted on purpose: it is a two-token flag or empty.
  # shellcheck disable=SC2086
  "$ORACLE" -addr "127.0.0.1:$PORT" $REFPEER_FLAG "$@" || true
  refpeer_reap
fi

# REAP BEFORE SURFACING, and the order is the whole point.
#
# This used to fall through to the EXIT trap, so the host was STILL RUNNING when its
# stderr was dumped -- which meant anything a host writes during shutdown was captured
# by nothing. The composition hosts print a post-traffic observation on SIGTERM
# (`COMPOSED-FINAL`), and it was invisible: the `COMPOSED` line printed at startup is
# necessarily before any traffic, so the only line that can answer "did a wire-driven
# write carry the caller's context" was the one being discarded.
#
# Reaping here is idempotent -- `reap_host` returns immediately if the pid is gone -- so
# the EXIT trap still covers every abort path above this point.
reap_host

# Surface the peer's own stderr. /tmp inside a --rm container is discarded with it, so
# without this a mid-run abort leaves a log reading only "connection refused". Not
# hypothetical: keystone's zig intermittent survived four investigations reported as
# "no crash, empty stderr" until this line existed, then produced a stack trace on the
# first reproduction.
if [ -s "$HOST_ERR" ]; then
  echo "--- peer stderr ---" >&2
  cat "$HOST_ERR" >&2
fi
