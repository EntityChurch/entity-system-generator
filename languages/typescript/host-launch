#!/bin/sh
# languages/typescript/host-launch — boot a composed peer and point the oracle at it.
#
#   host-launch <composition-name> [validate-peer args...]
#
# The shape already existed: every keystone peer ships a bare-peer launcher in its
# `run-s4.sh`. This adds a COMPOSITION entry point beside it; it does not invent a
# harness, and the composed host speaks keystone's host CLI verbatim so the readiness
# contract (one `LISTENING ...` line on stdout) is unchanged.
#
# Runs inside the node image with --network=none: the oracle is a fedora ELF binary
# that runs there too, so it and the peer share one loopback.
#
# Defaults to `-category content`. Pass args to override -- e.g. `-profile core` for
# the regression guard, which is not optional: our second failure mode is one keystone
# never has, the peer was right and we broke it.

set -eu

COMP="${1:?usage: host-launch <composition-name> [validate-peer args...]}"
shift

ROOT="${GENERATOR_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
STAGE="$ROOT/output/$COMP/build"
PORT="${PORT:-7777}"
ORACLE="${ORACLE:-$ROOT/../entity-core-keystone/output/s4-oracles/validate-peer}"

# BARE=1 launches the PEER'S OWN host out of the staged package instead of the
# composed one. That is the baseline arm, and it is not optional: "pre-existing
# failure" is a claim, and a claim about a failure needs the run that establishes it.
# ADR-0012 forbids labelling a failure pre-existing without bisecting; this is the
# cheapest honest bisect there is — same oracle, same flags, same container, one
# variable. It reads the bare host out of the STAGED copy of the peer's dist/, so the
# two arms differ by the composition and by nothing else, including the peer build.
if [ "${BARE:-0}" = "1" ]; then
  ENTRY="$STAGE/node_modules/entity-core-protocol-typescript/dist/test/host.js"
  ARM="bare"
else
  ENTRY="$STAGE/dist/host.js"
  ARM="composed"
fi

[ -f "$ENTRY" ] || { echo "host-launch: nothing built at $ENTRY" >&2
  echo "  run: ./languages/typescript/build $COMP" >&2; exit 2; }

# The oracle is a gitignored local build from the sibling entity-core-go tree. Missing
# it must be LOUD: keystone's harness ended in `|| true` and swallowed a missing binary
# for weeks, exiting 0 having validated nothing.
[ -x "$ORACLE" ] || { echo "host-launch: ERROR oracle not found or not executable at $ORACLE" >&2
  echo "  It is built from the sibling entity-core-go repo. It is the oracle BECAUSE" >&2
  echo "  it is not the thing under test; we do not ship a copy." >&2; exit 3; }

# The peer's persistent identity at the standard on-disk location, so the validator's
# probes that co-sign AS the peer can find its keypair. Seed 0x11 x 32 matches the
# host default, so peer_id is unchanged.
NAME="${PEERNAME:-conformance}"
KPDIR="${HOME:-/root}/.entity/peers/$NAME"
mkdir -p "$KPDIR"
printf '%s\n%s\n%s\n' \
  '-----BEGIN ENTITY PRIVATE KEY-----' \
  'ERERERERERERERERERERERERERERERERERERERERERE=' \
  '-----END ENTITY PRIVATE KEY-----' > "$KPDIR/keypair"

HOST_OUT="$(mktemp)"; HOST_ERR="$(mktemp)"
node "$ENTRY" --port "$PORT" --name "$NAME" --debug-open-grants --validate \
  >"$HOST_OUT" 2>"$HOST_ERR" &
HOST_PID=$!

# Deterministic teardown. `kill` only DELIVERS the signal; a fire-and-forget trap
# returns while the peer still owns the listening socket, and a second run in the same
# container fails to bind. keystone measured windows over 400 ms on some runtimes.
reap_host() {
  [ -n "${HOST_PID:-}" ] || return 0
  kill -0 "$HOST_PID" 2>/dev/null || return 0
  kill -TERM "$HOST_PID" 2>/dev/null || true
  j=0
  while [ "$j" -lt 50 ]; do
    kill -0 "$HOST_PID" 2>/dev/null || return 0
    j=$((j + 1)); sleep 0.1
  done
  kill -KILL "$HOST_PID" 2>/dev/null || true
  wait "$HOST_PID" 2>/dev/null || true
}
trap reap_host EXIT INT TERM

i=0
while [ "$i" -lt 100 ]; do
  grep -q '^LISTENING' "$HOST_OUT" 2>/dev/null && break
  if ! kill -0 "$HOST_PID" 2>/dev/null; then
    echo "host-launch: host exited before LISTENING:" >&2; cat "$HOST_ERR" >&2; exit 1
  fi
  i=$((i + 1)); sleep 0.1
done
head -1 "$HOST_OUT"
# The COMPOSED line proves the extension installed. A composed peer that silently
# installed nothing is byte-identical to a bare peer from the outside, and every
# content check would fail with a message about the PEER.
if [ "$ARM" = "composed" ]; then
  grep '^COMPOSED' "$HOST_ERR" || { echo "host-launch: the host printed no COMPOSED line -- nothing installed" >&2; exit 1; }
else
  echo "BASELINE arm=bare (no extensions installed)"
fi

[ "$#" -eq 0 ] && set -- -category content

mkdir -p "$ROOT/output/$COMP/reports"
"$ORACLE" -addr "127.0.0.1:$PORT" "$@" || true

# Surface the peer's own stderr. /tmp inside a --rm container is discarded with it, so
# without this a mid-run abort leaves a log reading only "connection refused". Not
# hypothetical: keystone's zig intermittent survived four investigations reported as
# "no crash, empty stderr" until this line existed, then produced a stack trace on the
# first reproduction.
if [ -s "$HOST_ERR" ]; then
  echo "--- peer stderr ---" >&2
  cat "$HOST_ERR" >&2
fi
