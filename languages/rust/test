#!/bin/sh
# languages/rust/test — run every staged extension's unit tests, plus the one check
# that can only be made by a compile that FAILS.
#
#   test <composition-name>
#
# Runs from the STAGED cell, so the integration tests in `tests/` see the crate exactly
# as a third party does: only `pub`. A `#[cfg(test)] mod tests` inside `src/` would see
# the private module and prove nothing about the §3.4 boundary, which is why the
# export-surface assertions live in `tests/` in this language and beside the package in
# the other two.
#
# `build` must have run. This does not build -- a test driver that silently rebuilds
# hides which change was measured.
#
# ## The compile-fail arm, and why it needs a control
#
# `src/bin/deep_import.rs` names the private module and MUST NOT compile. On its own
# that check is the purest D15 false green available: it reports its strongest result
# when the crate does not build at all, when the vendor mirror is missing, when rustc is
# the wrong version. So the failure is only interpreted after `cargo test` has passed --
# and `tests/sdk.rs` carries the positive half, naming the public route's exact
# signature, so "the boundary is where we say it is" is asserted from both sides.

set -eu

COMP="${1:?usage: test <composition-name>}"
ROOT="${GENERATOR_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
# THE TARGET IS THIS DRIVER'S OWN DIRECTORY. Under target-major a target is a unified
# bundle -- profile, cells, compositions, gate arms and output all under languages/<target>/
# -- so the driver never has to be told which target it is, and a (target, composition)
# mismatch has no filesystem location to be spelled in.
TARGET="$(basename "$(cd "$(dirname "$0")" && pwd)")"
TARGET_DIR="$ROOT/languages/$TARGET"
STAGE="$TARGET_DIR/output/$COMP/build"

[ -d "$STAGE/cells" ] || { echo "test: nothing staged at $STAGE/cells" >&2
  echo "  run: ./languages/rust/build $COMP" >&2; exit 2; }

# Set unconditionally. The image declares `ENV CARGO_HOME=/cargo`, so a `:-` default
# never fires -- see the longer note in `build`.
CARGO_HOME="$TARGET_DIR/output/.cargo-home"
export CARGO_HOME
export CARGO_TARGET_DIR="${GENERATOR_CARGO_TARGET_DIR:-$TARGET_DIR/output/$COMP/target}"
[ -f "$CARGO_HOME/config.toml" ] || { echo "test: no vendor config at $CARGO_HOME/config.toml" >&2
  echo "  run: ./languages/rust/build $COMP -- it writes the offline source replacement" >&2
  exit 2; }

RC=0
FOUND=0
for CELLDIR in "$STAGE"/cells/*; do
  [ -d "$CELLDIR" ] || continue
  NAME="$(basename "$CELLDIR")"
  if [ -z "$(find "$CELLDIR/tests" -name '*.rs' -print -quit 2>/dev/null)" ]; then
    # A cell with no tests is a real answer, not a pass.
    echo "test: $NAME has NO tests staged -- not a pass, an absence" >&2
    RC=1
    continue
  fi
  FOUND=$((FOUND + 1))

  echo "test: $NAME"
  if ( cd "$CELLDIR" && cargo test --offline --quiet ); then
    :
  else
    RC=1
    # A failing suite means the compile-fail arm below is uninterpretable for this
    # cell, so say so rather than scoring it.
    echo "test: $NAME FAILED -- skipping its compile-fail arm (no control)" >&2
    continue
  fi

  # ── the compile-fail arm ─────────────────────────────────────────────────
  #
  # THE FIXTURE DECLARES ITS CLAIMS, ONE ERROR CODE EACH, AND THIS DRIVER ENUMERATES
  # NOTHING (D20). A `//! CLAIMS: E0603 E0451` line names every refusal the fixture is
  # asserting; each must appear, and an error code the fixture did NOT claim fails the
  # arm. That is AP-42's rule -- "a compile-fail arm names each claimed error CODE, never
  # a count" -- and it is here because `content`'s fixture grew a SECOND claim on
  # 2026-09-16 (§3.4's anchor: a consumer cannot construct the peer's `HandlerContext`),
  # and a single hardcoded E0603 would have passed on a fixture whose new half never
  # compiled far enough to be refused for its own reason.
  #
  # ONE FIXTURE PER CLAIM, and the driver globs rather than naming `deep_import`. Two
  # claims in one binary is what the first draft did, and `rustc` refused the whole file
  # at name resolution -- so the second claim's error was never REACHED and the arm
  # reported it missing. That was the gate working on its author within the hour, and the
  # lesson generalises past this cell: a compile-fail fixture measures ONE refusal,
  # because the compiler stops at the first phase that has something to say.
  for FIXTURE in "$CELLDIR"/src/bin/*.rs; do
    [ -f "$FIXTURE" ] || continue
    FNAME="$(basename "$FIXTURE" .rs)"
    CLAIMS="$(sed -n 's/^\/\/!\s*CLAIMS:\s*//p' "$FIXTURE" | tr -s ' \t' ' ')"
    # A fixture with no CLAIMS header is unreadable, not clean: the arm would have
    # nothing to require and would report the refusal of a broken build as a boundary.
    if [ -z "$CLAIMS" ]; then
      echo "test: $NAME REFUSING -- src/bin/$FNAME.rs has no \`//! CLAIMS:\` line." >&2
      echo "  Name each error code this fixture asserts, e.g. \`//! CLAIMS: E0603\`." >&2
      RC=1
      continue
    fi
    echo "test: $NAME export boundary: $FNAME (a compile that must FAIL)"
    ERR="$CARGO_TARGET_DIR/$NAME-$FNAME.err"
    if ( cd "$CELLDIR" && cargo build --offline --quiet \
           --bin "$FNAME" --features compile-fail-fixture ) 2>"$ERR"; then
      echo "test: $NAME FIXTURE $FNAME COMPILED." >&2
      echo "  It asserts a refusal ($CLAIMS) and got none. Whatever boundary it names" >&2
      echo "  has moved -- that is the finding." >&2
      RC=1
    else
      # Every CLAIMED code must be present, and no UNCLAIMED one may be. A fixture that
      # failed for a reason that has nothing to do with the boundary -- a typo, a moved
      # symbol, a broken build -- reported as "the boundary holds" is the false green
      # this arm exists to avoid, and a claim that silently stopped being refused for its
      # own reason is the one four-of-four survived once already.
      SEEN="$(grep -oE '^error\[E[0-9]+\]' "$ERR" | tr -d 'error[]' | sort -u | tr '\n' ' ')"
      MISSING=""
      for C in $CLAIMS; do
        case " $SEEN " in *" $C "*) : ;; *) MISSING="$MISSING $C" ;; esac
      done
      UNCLAIMED=""
      for C in $SEEN; do
        case " $CLAIMS " in *" $C "*) : ;; *) UNCLAIMED="$UNCLAIMED $C" ;; esac
      done
      if [ -n "$MISSING" ] || [ -n "$UNCLAIMED" ]; then
        [ -n "$MISSING" ] && echo "test: $NAME claimed refusal(s) NOT observed:$MISSING" >&2
        [ -n "$UNCLAIMED" ] && echo "test: $NAME refused with UNCLAIMED code(s):$UNCLAIMED" >&2
        grep -E "^error" "$ERR" | head -8 | sed 's/^/          /' >&2
        echo "  The fixture must fail BECAUSE of what it claims. A different error means" >&2
        echo "  this arm measured the build, not the boundary; an extra one means a claim" >&2
        echo "  changed cause without anyone noticing (AP-42)." >&2
        RC=1
      else
        echo "test:   refused with exactly its claimed code(s): $CLAIMS"
        grep -E "^error\[E[0-9]+\]" "$ERR" | sed 's/^/          /'
      fi
    fi
  done
done

# Zero suites is not a clean run. The same refusal `tools/diff-arms.py` carries, for the
# same reason: an empty result set reported as green is the most comfortable wrong
# answer available (D15).
[ "$FOUND" -gt 0 ] || { echo "test: NO suites ran at all -- refusing to report OK" >&2; exit 1; }

[ "$RC" -eq 0 ] && echo "test: OK" || echo "test: FAILURES" >&2
exit "$RC"
