# Local agent context — injectable, never committed ([ADR-0020]).
AGENTS.local.md
.agents/

# Nothing secret belongs here; refuse it if it ever lands.
*.pem
*.secret
*.key
*-pat*

# Scratch / build output.
#
# NOT root-anchored, on purpose. Under target-major each target owns its own output
# (`languages/<target>/output/`), so a `/output/` pattern would have ignored the root's
# cross-target results and tracked every per-target one -- exactly backwards.
/scratch/
output/
target/
build/
__pycache__/
*.pyc
